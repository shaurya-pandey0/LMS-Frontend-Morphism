# ===========================================================================
#  LifeTrack — root .gitignore
#
#  Rule of thumb: anything that can be re-downloaded or re-generated from a
#  manifest (package.json, pom.xml, requirements.txt) is NOT committed.
#  `start-lifetrack.bat` installs all of it on first run.
# ===========================================================================

# --- Node / React frontend -------------------------------------------------
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/node_modules/.vite/
frontend/node_modules/.vite-temp/
.npm/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.eslintcache

# --- Java / Maven backend --------------------------------------------------
target/
backend/target/
build/
!**/src/**/target/
.mvn/wrapper/maven-wrapper.jar
*.class
*.jar
*.war
*.ear
hs_err_pid*
replay_pid*

# --- Python / FastAPI AI service ------------------------------------------
ai-service/.venv/
.venv/
venv/
env/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Local databases & generated data -------------------------------------
# Project-local MongoDB instance started by start-lifetrack.bat
data/
# Per-user local vector stores (embeddings + TurboVec indexes)
ai-service/data/
ai-service/data/users/
*.tvim
*.npz

# --- Secrets & environment ------------------------------------------------
# Never commit real keys. *.env.example files ARE committed as templates,
# and start-lifetrack.bat creates the real .env from them on first run.
.env
# Catch-all for every future variant (.env.prod, .env.app, .env.staging, ...).
# The *.example templates below are the only ones that belong in the repo.
.env.*
!.env.example
!.env.app.example
!.env.ai.example
!.env.*.example
ai-service/.env
*.pem
*.key
*.crt
*.p12
*.jks
.htpasswd
# SSH material, and GCP/AWS service-account key files.
id_rsa*
id_ed25519*
*service-account*.json
*credentials*.json
gcp-*.json
# Local compose overrides routinely hold host-specific ports and secrets.
docker-compose.override.yml

# --- Deployment artefacts --------------------------------------------------
# Database dumps and vector-store archives from deploy/scripts/backup-db.sh.
backups/
# TLS material and host-mounted nginx overrides (keep the directories).
deploy/nginx/certs/*
!deploy/nginx/certs/.gitkeep
deploy/nginx/conf.d/*
!deploy/nginx/conf.d/.gitkeep
# Database dumps and vector archives contain real user data even outside backups/.
*.sql.gz
*.dump

# --- Local scratch --------------------------------------------------------
# Working screenshots (cloud console panels, file listings). Deliberately
# narrow patterns: the tracked mockups in UI/ and docs/ must stay.
IGNORE/
Before Deployment files/
Modified Files Before Deployment Phase.png
Screenshot *.png
Screenshot *.jpg

# frontend/.env holds only local service URLs (no secrets) and is required
# for a fresh clone to build, so it is tracked deliberately.
!frontend/.env

# --- Logs & temp ----------------------------------------------------------
*.log
logs/
# Development-only snapshots of the exact outbound LLM request. Both contain a
# real user's name and aggregated lifestyle data, so neither belongs in the repo.
# prompt.json was tracked by mistake; see the note in DEPLOYMENT-FILES.md.
ai-service/prompt.md
ai-service/prompt.json
lint.txt
*.tmp
*.bak
*.orig

# --- IDE / editor ---------------------------------------------------------
# Eclipse
.metadata/
.settings/
.classpath
.project
.factorypath
.apt_generated/
# IntelliJ
.idea/
*.iml
*.iws
*.ipr
out/
# VS Code (keep shared settings if the team wants them; ignore local noise)
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
# Kiro
.kiro/

# --- OS -------------------------------------------------------------------
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
