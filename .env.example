# =============================================================================
#  LifeTrack deployment configuration — SINGLE VM (docker-compose.yml).
#  Copy to .env on the VM and fill in.
#
#     cp .env.example .env && nano .env
#
#  Splitting the app and the AI service across two VMs instead? Use
#  .env.app.example / .env.ai.example and see DEPLOYMENT-SPLIT.md.
#
#  .env is git-ignored. Never commit real secrets.
#  Generate strong values:
#     openssl rand -base64 48      # APP_JWT_SECRET (must be base64, >= 32 bytes)
#     openssl rand -hex 24         # DB passwords, USER_KEY_SALT
# =============================================================================

# --- General ----------------------------------------------------------------
TZ=UTC
# Tag applied to the locally built images.
IMAGE_TAG=latest
# Public port for nginx. Keep 80 unless something else already uses it.
HTTP_PORT=80
HTTPS_PORT=443

# --- MySQL ------------------------------------------------------------------
# REQUIRED. The database volume is initialised with these on first start only;
# changing them later does not update an existing volume.
MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_DATABASE=lifestyle_ai
MYSQL_USER=lifetrack
MYSQL_PASSWORD=change-me-app-password

# --- Backend (Spring Boot) --------------------------------------------------
# REQUIRED. Base64-encoded 256-bit key: openssl rand -base64 48
APP_JWT_SECRET=
# 24h in milliseconds.
APP_JWT_EXPIRATION_MS=86400000
# Hibernate schema management. `update` builds the schema on first boot; switch
# to `validate` once the schema is stable so deploys cannot alter it silently.
SPRING_JPA_HIBERNATE_DDL_AUTO=update
# Only needed for API clients that are NOT served through this nginx (the SPA is
# same-origin, so it needs no CORS entry). Comma-separated, scheme + host + port.
APP_CORS_ALLOWED_ORIGINS=http://localhost
# JVM tuning. The container has no memory limit set, so this is a % of host RAM.
# Keep the quotes: the deploy/backup scripts source this file with bash.
JAVA_OPTS="-XX:MaxRAMPercentage=70 -XX:+UseContainerSupport"

# Rule-based insight thresholds.
APP_INSIGHTS_MIN_SLEEP_HOURS=6.0
APP_INSIGHTS_GOOD_SLEEP_HOURS=7.5
APP_INSIGHTS_WEEKLY_SPENDING_THRESHOLD=1000.0
APP_INSIGHTS_MIN_WATER_INTAKE_ML=2000.0
APP_INSIGHTS_HABIT_CONSISTENCY_THRESHOLD=0.5

# --- AI service (FastAPI) ---------------------------------------------------
# Provider: openai | mistral | gemini | lmstudio
AI_PROVIDER=openai
# Leave blank to use the provider's default base URL. For a self-hosted
# LM Studio / vLLM reachable from the VM: http://HOST_OR_IP:1234/v1
AI_BASE_URL=
# REQUIRED. Rotate any key that was ever committed or shared.
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TEMPERATURE=0.4
AI_TIMEOUT_SECONDS=60
AI_MAX_TOKENS=800
AI_JSON_MODE=auto
# uvicorn workers. 2-4 is plenty; these are I/O-bound calls to the LLM.
AI_WORKERS=2

# Retrieval: full | local_vector
AI_RETRIEVAL_MODE=full
EMBEDDING_MODEL=text-embedding-3-small
VECTOR_TOP_K=5
VECTOR_CACHE_USERS=16
VECTOR_BIT_WIDTH=4
VECTOR_BACKEND=auto
MAX_SNIPPET_CHARS=500
# REQUIRED. Salts the on-disk per-user vector folder hash. Changing it after
# data exists orphans the existing stores. openssl rand -hex 24
USER_KEY_SALT=
# Same note as APP_CORS_ALLOWED_ORIGINS: only for non-same-origin callers.
CORS_ALLOWED_ORIGINS=http://localhost

# --- Frontend build args ----------------------------------------------------
# Baked into the bundle at build time. Same-origin paths proxied by nginx.
# Change these only if the APIs live on other hostnames, then rebuild `web`.
VITE_API_BASE_URL=/api
VITE_AI_BASE_URL=/ai

# --- Monitoring (docker compose --profile monitoring) -----------------------
PROM_RETENTION=15d
GRAFANA_ADMIN_USER=admin
# REQUIRED when using the monitoring profile.
GRAFANA_ADMIN_PASSWORD=change-me-grafana-password
GRAFANA_ROOT_URL=http://localhost:3000
