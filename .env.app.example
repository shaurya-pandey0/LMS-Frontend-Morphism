# =============================================================================
#  LifeTrack SPLIT DEPLOYMENT — APP VM (nginx + Spring Boot + MySQL).
#  Used with docker-compose.app.yml. Copy to .env on the app VM.
#
#     cp .env.app.example .env && nano .env && chmod 600 .env
#
#  The AI service is NOT configured here; it lives on the AI VM with
#  .env.ai.example. See DEPLOYMENT-SPLIT.md.
# =============================================================================

# --- General ----------------------------------------------------------------
# Docker Compose reads this, so plain `docker compose ps|logs|exec` on this VM
# uses the app stack instead of the single-VM docker-compose.yml. Leave it set.
COMPOSE_FILE=docker-compose.app.yml

TZ=UTC
IMAGE_TAG=latest
HTTP_PORT=80
HTTPS_PORT=443

# --- Link to the AI VM ------------------------------------------------------
# REQUIRED. Internal (VPC) address of the AI VM's edge, never a public IP.
# Find it with:
#   gcloud compute instances describe lifetrack-ai --zone=us-central1-a \
#     --format='get(networkInterfaces[0].networkIP)'
AI_UPSTREAM=http://10.128.0.5:8100

# REQUIRED. Shared secret injected as X-Internal-Token by this VM's nginx and
# verified by the AI VM's edge. Must be IDENTICAL on both hosts.
#   openssl rand -hex 32
AI_SHARED_TOKEN=

# --- MySQL ------------------------------------------------------------------
# REQUIRED. Applied only when the db_data volume is first initialised.
MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_DATABASE=lifestyle_ai
MYSQL_USER=lifetrack
MYSQL_PASSWORD=change-me-app-password

# --- Backend (Spring Boot) --------------------------------------------------
# REQUIRED. Base64-encoded 256-bit key: openssl rand -base64 48
APP_JWT_SECRET=
APP_JWT_EXPIRATION_MS=86400000
# `update` builds the schema on first boot; switch to `validate` once stable.
SPRING_JPA_HIBERNATE_DDL_AUTO=update
# Only for API clients not served through this nginx. The SPA is same-origin.
APP_CORS_ALLOWED_ORIGINS=http://localhost
# Keep the quotes: the deploy/backup scripts source this file with bash.
JAVA_OPTS="-XX:MaxRAMPercentage=70 -XX:+UseContainerSupport"

APP_INSIGHTS_MIN_SLEEP_HOURS=6.0
APP_INSIGHTS_GOOD_SLEEP_HOURS=7.5
APP_INSIGHTS_WEEKLY_SPENDING_THRESHOLD=1000.0
APP_INSIGHTS_MIN_WATER_INTAKE_ML=2000.0
APP_INSIGHTS_HABIT_CONSISTENCY_THRESHOLD=0.5

# --- Frontend build args ----------------------------------------------------
# Same-origin paths proxied by this VM's nginx. /ai is forwarded to AI_UPSTREAM,
# so the browser never learns that the AI service is on a different host.
# Inlined at build time: changing these needs `docker compose build web`.
VITE_API_BASE_URL=/api
VITE_AI_BASE_URL=/ai

# --- Monitoring (--role app --monitoring) -----------------------------------
PROM_RETENTION=15d
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana-password
GRAFANA_ROOT_URL=http://localhost:3000
