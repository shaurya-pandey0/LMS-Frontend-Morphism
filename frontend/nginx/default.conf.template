# =============================================================================
#  LifeTrack edge config: serves the React SPA and reverse-proxies the APIs.
#
#    /            -> static SPA bundle (history fallback to index.html)
#    /api/...     -> Spring Boot backend      (prefix preserved)
#    /ai/...      -> FastAPI AI service       (prefix stripped)
#    /actuator/*  -> blocked from the public internet (Prometheus scrapes
#                    the backend directly over the internal network)
#
#  Everything is same-origin, so no CORS preflights and no browser-visible
#  service ports.
#
#  This is an nginx TEMPLATE. The official nginx entrypoint renders it to
#  /etc/nginx/conf.d/default.conf at container start, substituting:
#
#    BACKEND_UPSTREAM   default http://backend:8080
#    AI_UPSTREAM        default http://ai-service:8100
#                       split deployment: http://AI_VM_INTERNAL_IP:8100
#    AI_PROXY_TOKEN     default empty; shared secret sent to a remote AI VM.
#                       nginx omits the header entirely when it is empty.
#
#  Only those three names are substituted (NGINX_ENVSUBST_FILTER), so nginx's
#  own $host / $uri / $remote_addr variables are left alone.
# =============================================================================

# Cheap abuse protection for the LLM-backed endpoints, which are expensive and
# (see DEPLOYMENT.md) currently unauthenticated in the AI service itself.
limit_req_zone $binary_remote_addr zone=ai_zone:10m rate=20r/m;
limit_req_zone $binary_remote_addr zone=api_zone:10m rate=600r/m;
limit_req_status 429;

# Extra server blocks mounted from the host at deploy/nginx/conf.d (TLS, extra
# vhosts). Declared after the zones above so those blocks can reuse them.
# A wildcard that matches nothing is not an error.
include /etc/nginx/conf.d/extra/*.conf;

server {
    listen 80;
    listen [::]:80;
    server_name _;

    # Docker's embedded DNS, which also forwards external names. Resolving
    # upstreams at request time keeps nginx alive when a backend container is
    # recreated with a new IP, or when the AI VM's address changes.
    resolver 127.0.0.11 valid=10s ipv6=off;
    resolver_timeout 5s;

    root /usr/share/nginx/html;
    index index.html;

    client_max_body_size 12m;
    server_tokens off;

    include /etc/nginx/snippets/security-headers.conf;

    # --- Compression ---------------------------------------------------------
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_types text/plain text/css text/javascript application/javascript
               application/json application/xml image/svg+xml font/woff2;

    # --- Container / LB health probe ----------------------------------------
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # --- Spring Boot API ----------------------------------------------------
    location /api/ {
        limit_req zone=api_zone burst=120 nodelay;

        set $backend_upstream "${BACKEND_UPSTREAM}";
        proxy_pass $backend_upstream$request_uri;

        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection        "";

        proxy_connect_timeout 5s;
        proxy_send_timeout    60s;
        proxy_read_timeout    60s;
    }

    # --- Swagger UI / OpenAPI (comment out to hide it in production) ---------
    location ~ ^/(swagger-ui|v3/api-docs) {
        set $backend_upstream "${BACKEND_UPSTREAM}";
        proxy_pass $backend_upstream$request_uri;

        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection        "";
    }

    # --- FastAPI AI service (prefix stripped: /ai/chat -> /chat) -------------
    location /ai/ {
        limit_req zone=ai_zone burst=10 nodelay;

        set $ai_upstream "${AI_UPSTREAM}";
        rewrite ^/ai/(.*)$ /$1 break;
        proxy_pass $ai_upstream;

        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection        "";
        # Shared secret for a remote AI VM. Empty value -> header not sent.
        proxy_set_header X-Internal-Token  "${AI_PROXY_TOKEN}";

        # LLM calls can legitimately take a while (AI_TIMEOUT_SECONDS=60).
        proxy_connect_timeout 5s;
        proxy_send_timeout    180s;
        proxy_read_timeout    180s;
        proxy_buffering       off;
    }

    # --- Actuator: never reachable from outside -----------------------------
    location /actuator/ {
        return 403;
    }

    # --- Static assets: content-hashed, cache hard --------------------------
    location /assets/ {
        include /etc/nginx/snippets/security-headers.conf;
        expires 1y;
        add_header Cache-Control "public, immutable";
        access_log off;
        try_files $uri =404;
    }

    location ~* \.(?:ico|png|jpg|jpeg|gif|svg|webp|woff2?|ttf|eot)$ {
        include /etc/nginx/snippets/security-headers.conf;
        expires 30d;
        add_header Cache-Control "public";
        access_log off;
        try_files $uri =404;
    }

    # --- SPA history fallback ------------------------------------------------
    location / {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache, must-revalidate";
        try_files $uri $uri/ /index.html;
    }
}
