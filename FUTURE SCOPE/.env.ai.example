# =============================================================================
#  LifeTrack SPLIT DEPLOYMENT — AI VM (FastAPI + edge gate).
#  Used with docker-compose.ai.yml. Copy to .env on the AI VM.
#
#     cp .env.ai.example .env && nano .env && chmod 600 .env
#
#  This host holds no database and serves no browser traffic. See
#  DEPLOYMENT-SPLIT.md.
# =============================================================================

# --- General ----------------------------------------------------------------
# Docker Compose reads this, so plain `docker compose ps|logs|exec` on this VM
# uses the AI stack instead of the single-VM docker-compose.yml. Leave it set.
COMPOSE_FILE=docker-compose.ai.yml

TZ=UTC
IMAGE_TAG=latest

# --- Edge gate --------------------------------------------------------------
# REQUIRED. Must be IDENTICAL to AI_SHARED_TOKEN on the app VM. Requests without
# a matching X-Internal-Token header get 403.
#   openssl rand -hex 32
AI_SHARED_TOKEN=

# Address the edge listens on. Prefer this VM's internal VPC IP so the service
# is not bound to the external NIC at all:
#   AI_BIND_IP=$(curl -s -H "Metadata-Flavor: Google" \
#     http://metadata.google.internal/computeMetadata/v1/instance/network-interfaces/0/ip)
# 0.0.0.0 works too, but then only the firewall rule stands between the
# internet and the edge.
AI_BIND_IP=0.0.0.0
AI_PUBLISH_PORT=8100

# --- LLM provider -----------------------------------------------------------
# openai | mistral | gemini | lmstudio
AI_PROVIDER=openai
# Blank uses the provider default. For a self-hosted OpenAI-compatible server
# reachable from this VM: http://HOST_OR_IP:1234/v1
AI_BASE_URL=
# REQUIRED. Rotate any key that was ever committed or shared.
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TEMPERATURE=0.4
AI_TIMEOUT_SECONDS=60
AI_MAX_TOKENS=800
AI_JSON_MODE=auto
# uvicorn workers. These calls are I/O-bound; this VM does little else, so it
# can afford more than the single-VM default of 2.
AI_WORKERS=4

# --- Retrieval / local vector store ----------------------------------------
# full | local_vector
AI_RETRIEVAL_MODE=full
EMBEDDING_MODEL=text-embedding-3-small
VECTOR_TOP_K=5
VECTOR_CACHE_USERS=16
VECTOR_BIT_WIDTH=4
VECTOR_BACKEND=auto
MAX_SNIPPET_CHARS=500
# REQUIRED. Salts the on-disk per-user folder hash. Changing it after data
# exists orphans the existing stores. openssl rand -hex 24
USER_KEY_SALT=

# Irrelevant in this topology (requests arrive server-to-server from the app
# VM's nginx, not from a browser). Left restrictive on purpose.
CORS_ALLOWED_ORIGINS=http://localhost
